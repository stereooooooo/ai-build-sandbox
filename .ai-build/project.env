# Project settings for scripts/ai-task.sh. Committed to the repository and read by the launcher
# from the main checkout (it is executed as shell, so only commit what you would run).
# Plain shell assignments. Values marked (doc) are not used by the launcher; they record
# decisions that agents and people need (see AGENTS.md too). Derive every value from this
# project's own files; leave a value empty rather than guess.

DEFAULT_BRANCH="main"            # branch every task starts from (fetched fresh from origin)
BRANCH_PREFIX="task/"            # task branches are named <prefix><task-name>
WORKTREE_DIR=".claude/worktrees" # where task worktrees go, relative to the main checkout

INSTALL_CMD="npm ci"                   # e.g. "npm ci"; runs with .ai-task.env loaded, after the
                                 # database check below. "" to skip
TEST_CMD="npm test"                      # (doc) the baseline test command
DEV_CMD='PORT=$PORT npm run dev'                       # (doc) e.g. 'PORT=$PORT npm run dev'

PORT_BASE=3100                   # each task gets a port in PORT_BASE..PORT_BASE+PORT_RANGE-1
PORT_RANGE=100

COPY_FILES=""                    # gitignored local files copied into each worktree, e.g. ".env.local"
                                 # (space-separated; never files holding production credentials)

# Gitignored paths that are safe to delete when a task finishes, e.g. "node_modules/ .next/
# *node_modules/ coverage/". Shell patterns; "*" also matches across folders. Anything ignored
# and NOT listed here (and not an unchanged copy of a COPY_FILES file) is treated as work:
# finish stops, and finish --rescue preserves it. Do not list folders that hold local data,
# such as .wrangler/ (local D1 and KV state).
DISPOSABLE="node_modules/ *node_modules/"

# Per-task database (leave DB_PREFIX empty if the project has no local database, or if the
# database already lives inside the worktree, such as wrangler's .wrangler/state).
DB_PREFIX=""                     # e.g. "myapp_dev": the task database is <prefix>_<task_name>
DB_CREATE_CMD=""                 # e.g. 'createdb "$AI_TASK_DB"'
DB_ENV_CMD=""                    # prints KEY=VALUE lines added to .ai-task.env, e.g.
                                 # 'echo "DATABASE_URL=postgres://localhost:5432/$AI_TASK_DB"'
DB_VERIFY_CMD=""                 # REQUIRED when DB_PREFIX is set. Runs with .ai-task.env loaded and
                                 # must succeed only if the app's own configuration resolves to
                                 # $AI_TASK_DB (check precedence of .env files), e.g.
                                 # 'node scripts/print-db-name.mjs | grep -qx "$AI_TASK_DB"'
DB_DUMP_CMD=""                   # writes a dump to "$AI_TASK_DUMP", e.g.
                                 # 'pg_dump -Fc -f "$AI_TASK_DUMP" "$AI_TASK_DB"'
DB_DROP_CMD=""                   # e.g. 'dropdb --if-exists "$AI_TASK_DB"' (only with finish --drop-db)

RESCUE_DIR=""                    # where finish --rescue keeps local files; default ~/.ai-task-rescue

CLAUDE_MODE="plain"              # "plain": start `claude` in the worktree
                                 # "worktree": `claude --worktree <task>` from the main checkout
                                 #   (adds Claude Code's isolation checks; verify on your machine first)

RELEASE_TRIGGER="manual"               # (doc) manual | on-merge | tag
VERIFY_CMD="none"                    # (doc) how to confirm what production is serving
